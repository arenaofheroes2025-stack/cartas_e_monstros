{
  "name": "cartas-e-monstros",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "art:build": "node scripts/build-art.mjs",
    "art:items": "node scripts/build-items.mjs",
    "art:anchors": "node scripts/build-sprite-anchors.mjs",
    "lan": "npm run build && node scripts/lan-preview.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --configLoader runner"
  },
  "dependencies": {
    "@react-three/fiber": "^9.3.0",
    "nipplejs": "^1.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.180.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.4"
  }
}
